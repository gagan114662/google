# PostgreSQL Database URL
# Example: DATABASE_URL=postgresql://user:password@localhost:5432/chimera_db
DATABASE_URL=postgresql://chimera_user:chimera_password@localhost:5432/chimera_dev

# Redis Connection URL
# Example: REDIS_URL=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# LLM API Keys (example for OpenAI)
# OPENAI_API_KEY=your_openai_api_key_here

# Other configurations
# CHIMERA_SECRET_KEY=a_very_strong_and_random_secret_key_for_jwt_etc
# CHIMERA_LOG_LEVEL=INFO
